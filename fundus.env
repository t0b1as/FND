# =============================================================================
#  /etc/fundus/fundus.env – Fundus Marketplace Node Konfiguration
#
#  Nach Änderungen neu laden:
#    sudo systemctl restart fundus-node
# =============================================================================

# -----------------------------------------------------------------------------
#  Netzwerk
# -----------------------------------------------------------------------------

# Port der lokalen REST-API (nur localhost – nginx proxied nach außen)
FUNDUS_PORT=3000

# libp2p P2P-Port (muss von außen erreichbar sein für DHT-Routing)
FUNDUS_P2P_PORT=4001

# Bind-Adresse für P2P (0.0.0.0 = alle Interfaces)
FUNDUS_P2P_HOST=0.0.0.0

# Bootstrap-Peers: kommagetrennte Multiaddr-Liste
# Leer lassen für reinen LAN-Betrieb (mDNS reicht dann)
# Beispiel: /ip4/1.2.3.4/tcp/4001/p2p/12D3KooW...
FUNDUS_BOOTSTRAP_PEERS=
# ── Fernzugriff / NAT (Mobilfunk, CGNAT) ─────────────────────────────────────
# Node hinter Mobilfunk/CGNAT: hier die öffentlich erreichbare Adresse des
# Heim-Nodes eintragen (Port 4001 TCP+UDP im Router weitergeleitet), z.B.
#   FUNDUS_BOOTSTRAP_PEERS=/ip4/<Heim-IP>/tcp/4001/p2p/<PeerID>,/ip4/<Heim-IP>/udp/4001/quic-v1/p2p/<PeerID>
# Die Verbindung wird gehalten und alle 30 s neu aufgebaut.
# Eigene Relays (vor den öffentlichen), Multiaddr inkl. /p2p/<PeerID>:
FUNDUS_P2P_RELAYS=
# Dieser Node bietet anderen Relay an (wird automatisch aktiv, sobald er öffentlich erreichbar ist):
FUNDUS_P2P_RELAY_SERVICE=true

# Erreichbarkeit vorgeben, statt auf AutoNAT zu warten (bei wenigen Nodes bleibt
# AutoNAT oft lange unentschieden – dann starten weder Relay-Dienst noch
# Relay-Suche):
#   auto    = AutoNAT entscheidet (Standard)
#   public  = Port 4001 TCP+UDP ist weitergeleitet / öffentliche IP → dieser Node
#             vermittelt für andere (Relay + Hole-Punching-Koordination)
#   private = hinter NAT/CGNAT (z.B. Mobilfunk) → sofort Relay suchen
# Mindestens EIN Node im Netz sollte "public" sein – er ist der Treffpunkt, über
# den sich zwei NAT-Nodes finden und das Hole Punching koordinieren.
FUNDUS_P2P_REACHABILITY=auto
# Zusätzlich announcte eigene Adressen, falls UPnP die öffentliche IP nicht
# erkennt, z.B. /ip4/<öffentl.IP>/tcp/4001,/ip4/<öffentl.IP>/udp/4001/quic-v1
FUNDUS_P2P_ANNOUNCE=
# ── Anrufe (WebRTC) ──────────────────────────────────────────────────────────
# TURN-Server für Audio/Video, wenn beide Seiten hinter strengem NAT sitzen
# (z.B. beide im Mobilfunk). Z.B. coturn auf einem Node mit Portfreigabe 3478:
#   FUNDUS_TURN_URLS=turn:<öffentl.IP>:3478?transport=udp,turn:<öffentl.IP>:3478?transport=tcp
FUNDUS_TURN_URLS=
FUNDUS_TURN_USER=
FUNDUS_TURN_PASS=
# Automatisches Order-Matching (seriell, 1 Swap gleichzeitig). false = aus.
FUNDUS_SWAP_AUTO=true
# ── Aufbewahrung (TTL, Tage; 0 = nie löschen) ────────────────────────────────
# Nicht abgeholte Offline-Nachrichten (Mailbox/Outbox):
FUNDUS_TTL_MAILBOX_DAYS=60
# Keydir, Kontakte, E-Mail-Verzeichnis FREMDER Nutzer (eigene Heim-Nutzer bleiben):
FUNDUS_TTL_DIRECTORY_DAYS=365
# Messenger-Verlauf (einzelne Nachrichten beim Login; inaktive Nutzer nach 2×):
FUNDUS_TTL_HISTORY_DAYS=365

# Maximale Anzahl Peer-Replikate (eigene Daten + 5 andere Nodes cachen)
FUNDUS_PEERS_MAX=5

# -----------------------------------------------------------------------------
#  Storage
# -----------------------------------------------------------------------------

FUNDUS_DATA_DIR=/opt/fundus/data
FUNDUS_LOG_DIR=/var/log/fundus

# -----------------------------------------------------------------------------
#  LLM-Analyse (Ollama)
# -----------------------------------------------------------------------------

# Aktivieren wenn Ollama läuft: sudo systemctl start ollama
FUNDUS_LLM_ENABLED=false

# Multimodales Modell für Bild-Analyse (läuft auf Pi 3+)
# Alternativen: llava:7b (besser, aber langsamer), moondream2 (schneller)
FUNDUS_LLM_MODEL=moondream2

# -----------------------------------------------------------------------------
#  Smartmeter
# -----------------------------------------------------------------------------

# Protokoll: sml | d0 | http | mock
# Leer lassen um Meter zu deaktivieren
FUNDUS_METER_PROTOCOL=

# Serieller Port (SML/D0) – typische Werte:
#   USB-Adapter:      /dev/ttyUSB0
#   GPIO UART (Pi):   /dev/ttyAMA0
FUNDUS_METER_PORT=/dev/ttyUSB0

# HTTP-Endpunkt für Shelly EM, Tasmota etc.
# Beispiel: http://192.168.1.50/status
FUNDUS_METER_HTTP_URL=

# Eindeutige Zähler-ID (wird in jeden Token eingebettet)
# Empfehlung: Seriennummer des Zählers oder UUID
FUNDUS_METER_ID=

# GPS-Koordinaten des Zähler-Standorts (Verbraucher)
# Für korrekte Netzgebühr-Berechnung erforderlich
FUNDUS_METER_LAT=0.0
FUNDUS_METER_LON=0.0

# GPS-Koordinaten des Erzeugers (z.B. PV-Anlage, Windrad)
# Kann identisch mit Meter-Standort sein bei Eigenverbrauch
FUNDUS_METER_GEN_LAT=0.0
FUNDUS_METER_GEN_LON=0.0

# HMAC-SHA256 Schlüssel für Token-Signierung (Hex, min. 32 Byte = 64 Hex-Zeichen)
# Generieren: openssl rand -hex 32
FUNDUS_METER_SIGN_KEY=

# -----------------------------------------------------------------------------
#  FND Shop (SOL → FND Token kaufen)
# -----------------------------------------------------------------------------

# Shop aktivieren (Standard: false)
FUNDUS_SHOP_ENABLED=false

# Solana-Adresse die SOL-Zahlungen empfängt (Pflichtfeld wenn SHOP_ENABLED=true)
# Generieren: solana-keygen new --outfile /etc/fundus/shop-wallet.json
FUNDUS_SHOP_RECEIVE_ADDR=DFG9searBsQXZkqh8L3q4sYVFNv32U2TmKLwBLPv4jW7

# ── SOL→FND-Brücke (native Chain) ───────────────────────────────────────────
# Die Brücke schreibt nach bestätigter SOL-Zahlung FND auf der nativen Chain gut.
#
# FUNDUS_SHOP_BRIDGE_AUTHORITY = ÖFFENTLICHE Fundus-Adresse des Brücken-Operators.
#   Muss auf ALLEN Nodes gesetzt sein (auch ohne Shop!), damit alle dieselben
#   SOL-Gutschriften als gültig anerkennen. Enthält KEIN Geheimnis — nur die
#   Adresse. Diese Adresse ist NICHT der FeeCollector und NICHT ein User-Key,
#   sondern ein eigener, dedizierter Brücken-Account.
FUNDUS_SHOP_BRIDGE_AUTHORITY=0xeaf2aa7ed76b5bb55389d45d382e4b6014960e77
#
# FUNDUS_SHOP_BRIDGE_PRIV_KEY = PRIVATER Schlüssel des Brücken-Operators.
#   ============================================================================
#   SICHERHEIT: NUR auf dem Shop-Node des Betreibers setzen. NIEMALS an User
#   geben, NIEMALS in Git, NIEMALS in die Repo-/ZIP-Version dieser Datei.
#   Wer diesen Key hat, kann FND minten. Muss zur Adresse in
#   FUNDUS_SHOP_BRIDGE_AUTHORITY passen (der Node prüft das beim Start).
#   Nodes OHNE Shop lassen dieses Feld leer.
#   ============================================================================
FUNDUS_SHOP_BRIDGE_PRIV_KEY=

# Solana RPC-Endpunkt
# Mainnet: https://api.mainnet-beta.solana.com
# Devnet:  https://api.devnet.solana.com
# Günstiger eigener: https://solana-rpc.net
FUNDUS_SHOP_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Slippage-Puffer in Basispunkten (50 = 0.5%)
# Schützt gegen Kursschwankungen zwischen Preisanzeige und Eingang
FUNDUS_SHOP_SLIPPAGE_BPS=50

# Gültigkeitsdauer eines Kauf-Angebots in Sekunden (Standard: 90)
FUNDUS_SHOP_OFFER_TTL_SEC=90

# -----------------------------------------------------------------------------
#  Blockchain (Gnosis Chain)
# -----------------------------------------------------------------------------

# Chain-ID: 100 = Gnosis Mainnet, 10200 = Chiado Testnet, 31337 = Hardhat
FUNDUS_CHAIN_ID=100

# Gnosis Chain RPC-Endpunkt
FUNDUS_CHAIN_RPC_URL=https://rpc.gnosischain.com

# Smart Contract Adressen (nach Deployment mit scripts/deploy.js)
# WICHTIG: FUNDUS_FND_ADDRESS muss die Adresse sein, an der der FND-Contract
# auf DIESER Chain (siehe CHAIN_ID/RPC oben) tatsächlich deployed ist.
# Bleibt sie leer, meldet die Wallet "Kein FND-Contract konfiguriert".
# Für Hardhat-Test: CHAIN_ID=31337, RPC_URL=http://127.0.0.1:8545 (bzw. Pi-IP),
# FND_ADDRESS = die vom deploy.js ausgegebene Adresse.
FUNDUS_FND_ADDRESS=
FUNDUS_ENERGY_TOKEN_ADDRESS=
FUNDUS_MARKET_ADDRESS=

# Private Key des Node-Wallets für Mint-Transaktionen (ACHTUNG: sicher speichern!)
# ============================================================================
#  OPTIONAL — der Node erzeugt automatisch einen eigenen Schlüssel!
#  Wenn dieses Feld LEER bleibt, legt der Node beim ersten Start selbst einen
#  Schlüssel an und speichert ihn persistent in <DataDir>/node.key (chmod 600).
#  Jeder Node hat so automatisch seine EIGENE Wallet — genau richtig für den
#  dezentralen Betrieb. Du musst hier also nichts eintragen.
#
#  Dieses Feld nur setzen, wenn du eine BESTIMMTE, bereits existierende Wallet
#  verwenden willst (z.B. eine eigene Seed importieren).
#
#  SICHERHEIT (falls gesetzt):
#   - NIEMALS in Git einchecken (diese Datei ist in .gitignore).
#   - NIEMALS in die lokale Repo-/ZIP-Version dieser Datei schreiben.
#   - NUR direkt auf dem Node in /etc/fundus/fundus.env eintragen (per SSH),
#     danach: sudo chmod 600 /etc/fundus/fundus.env
# ============================================================================
FUNDUS_WALLET_PRIV_KEY=

# Betreiber-Wallet für Storage-/Transfer-Verdienst (FND aus dem Filesharing-Netz).
# Auf diese Adresse wird der verdiente FND gebucht (sie steht als Provider in den
# Quittungen). Leer = Node-Wallet (node.seed, 128 MiB – ihre Seed-Wörter ergeben
# in der normalen Wallet eine ANDERE Adresse). Empfehlung: die eigene Nutzer-
# Wallet (256 MiB, wie fnd-wallet) eintragen – oder bequemer auf der Wallet-Seite
# "Einnahmen an meine Wallet" (hat Vorrang, wirkt ohne Neustart).
FUNDUS_STORAGE_REWARD_ADDR=

# FND Fee Collector
# Gebühren-Adresse (Argon2id v2, 256 MiB, salt fundus-fnd-v2)
# HINWEIS: nach der 256-MiB-Umstellung neu aus dem Seed ableiten (fnd-wallet)!
FUNDUS_FND_FEE_COLLECTOR=0xea5594a7cc26d2456e9a033481d01a5ba101c8f8

# FileStorage Contract (nach Deployment)
FUNDUS_FILE_STORAGE_ADDRESS=

# -----------------------------------------------------------------------------
#  Dezentrales Filesharing
# -----------------------------------------------------------------------------

# FUNDUS_STORAGE_OFFER_GB:
#   -1  = automatisch 50% des freien Speichers anbieten (Standard, empfohlen)
#    0  = Filesharing komplett deaktiviert
#   >0  = fester Wert in GB (z.B. 100 für 100 GB)
#   Hinweis: lokal werden mind. 5× dieser Wert reserviert (Replikate anderer Nodes).
FUNDUS_STORAGE_OFFER_GB=-1

# FUNDUS_STORAGE_ALLOC_GB:
#   Tatsächlich auf der Disk reservierter Speicher.
#   MINIMUM: 5 × FUNDUS_STORAGE_OFFER_GB
#   Begründung:
#     - Eigene Chunks:         1 × OfferGB
#     - Spiegel-Chunks anderer: 4 × OfferGB (5-fach Redundanz im Netz)
#     - Gesamt reserviert:     5 × OfferGB
#   Wenn 0: wird automatisch auf 5 × OfferGB gesetzt.
#   Kann zur Laufzeit erweitert werden:
#     curl -X POST localhost:3000/api/v1/admin/storage/expand \
#          -d '{"alloc_gb": 500, "offer_gb": 100}'
#
#   Beispiel (10 GB Angebot → 50 GB Allokation):
#     FUNDUS_STORAGE_OFFER_GB=10
#     FUNDUS_STORAGE_ALLOC_GB=50
FUNDUS_STORAGE_ALLOC_GB=0

# Verzeichnis für lokale Chunk-Daten und Alloc-Datei
# Empfehlung: externe HDD/SSD, nicht die System-SD-Karte
FUNDUS_STORAGE_DIR=/opt/fundus/chunks

# -----------------------------------------------------------------------------
#  Seed-Wörter für persönlichen Datei-Index
# -----------------------------------------------------------------------------
# Ermöglicht automatische Wiederherstellung aller eigenen Dateien auf neuem Pi.
#
# FUNDUS_SEED_FILE (empfohlen): Pfad zur Datei mit 30 Seed-Wörtern (1 pro Zeile).
#   chmod 400 /etc/fundus/seed.txt  ← nur root lesbar
#   Vorteil: nicht in ps aux oder env sichtbar
FUNDUS_SEED_FILE=/etc/fundus/seed.txt
#
# FUNDUS_SEED_WORDS (Alternative): Wörter direkt in Env (space-separated)
# Nicht empfohlen auf Produktionsservern (in /proc/PID/environ lesbar)
# FUNDUS_SEED_WORDS=wort1 wort2 wort3 ... (30 Wörter, NICHT empfohlen - besser wallet.key Datei)

# -----------------------------------------------------------------------------
#  Partner-Modul
# -----------------------------------------------------------------------------

# Maximales Alter gecachter PublicAds (Stunden, Standard: 24)
FUNDUS_PARTNER_AD_TTL_H=24

# Maximale Anzahl gecachter fremder Ads pro Typ (Standard: 500)
FUNDUS_PARTNER_CACHE_MAX=500

# Opt-in: SearchableAds automatisch nach jedem Profil-Update neu publizieren
# "false" = User muss manuell auf "Für Suche veröffentlichen" klicken
FUNDUS_PARTNER_AUTO_PUBLISH_SEARCH=false

# -----------------------------------------------------------------------------
#  Laufzeitumgebung
# -----------------------------------------------------------------------------

NODE_ENV=production

# -----------------------------------------------------------------------------
#  Topologie & Handelsnetz
# -----------------------------------------------------------------------------

# Node-Typ: consumer | prosumer | substation | power_plant
# consumer    = reiner Verbraucher (kein Verkauf)
# prosumer    = Verbraucher mit Eigenerzeugung (Solar/BHKW)
# substation  = Trafostation (ONT/Umspannwerk) – hat eigenes Wallet + Gebühr
# power_plant = reiner Erzeuger (Windpark, PV-Großanlage)
FUNDUS_NODE_TYPE=consumer

# Spannungsebene: lv | mv | hv | ehv
# lv  = Niederspannung  230/400 V  (Haushalte, Gewerbe)
# mv  = Mittelspannung  10-30 kV   (Trafostation ONT-Ausgang, größere Abnehmer)
# hv  = Hochspannung    110-220 kV (Umspannwerk)
# ehv = Höchstspannung  380 kV     (ÜNB-Netz)
FUNDUS_VOLTAGE_LEVEL=lv

# GPS-Koordinaten dieses Nodes (für Distanzberechnung)
# Wird für Routing und Netzgebühr-Berechnung genutzt
FUNDUS_NODE_LAT=0.0
FUNDUS_NODE_LON=0.0

# Übergeordnete Trafostation (Peer-ID des ONT)
# Bei Consumer/Prosumer: Peer-ID der lokalen Trafostation
# Bei Trafostation: Peer-ID des übergeordneten Umspannwerks
# Leer = kein direkter Trafo-Anschluss bekannt
FUNDUS_PARENT_SUBSTATION=

# Durchleitungsgebühr in % (NUR für substation-Nodes)
# Beispiel: 0.5 = 0,5% pro Transaktion die durch diese Trafo geht
FUNDUS_TRANSIT_FEE_PERCENT=0

# Google Maps Distance Matrix API Key (optional)
# Für genaue Kabelweg-Schätzung (Straßendistanz als Proxy)
# Ohne API-Key: Luftlinie × 1.3 als Fallback
FUNDUS_GMAPS_API_KEY=

# Meter Serial Params
FUNDUS_METER_BAUD=115200
FUNDUS_METER_DATABITS=8
FUNDUS_METER_STOPBITS=1
FUNDUS_METER_PARITY=N

# Kapazitäts-Management
FUNDUS_TRAFO_RATED_KW=400
FUNDUS_SETTLEMENT_METHOD=ansatz3

# Matching
# Bloom-Filter-Größe in Bits (Standard 4096, erhöhen bei >50 Interessen/Node)
FUNDUS_BLOOM_FILTER_SIZE=4096

# ── Verzeichnis-Shares ─────────────────────────────────────────────────────────
# Share-Metadaten-Verzeichnis (Standard: DataDir/shares)
# FUNDUS_SHARE_DATA_DIR=

# Flat-Listing: In der Web-UI beim Erstellen einer Share pro Ordner wählbar.
# Mit flat_listing=true werden Dateien direkt nebeneinander gelistet,
# ohne übergeordneten Ordner. Nützlich für: Medienbibliotheken, Dokument-Pools,
# wenn mehrere lokale Quellen (NAS, USB, Pi-lokal) als eine Share erscheinen sollen.

# ── Grid-Wallet (Gebühren-Adresse) ─────────────────────────────────────────────
# Die Gebühren-Wallet wird einmalig aus den 30 Seed-Wörtern abgeleitet:
#   fundus-admin shares --create … (oder via Admin-UI)
#   POST /api/v1/admin/grid/init  mit { "words": ["word1", ...] }
#
# Argon2id-Parameter (v2, final):
#   Salt:   BLAKE2b("fundus-grid-v2:" + operatorID) → 32 Bytes
#   Memory: 512 MiB
#   Time:   t=4
#   ~11s pro Wallet auf Pi 3
#
# WICHTIG: v2-Parameter erzeugen andere Adressen als v1 (64 MiB).
# Nach dem Upgrade neue Adressen ableiten und FND transferieren.

# =============================================================================
#  Dezentrale Updates (Git + P2P)
# =============================================================================
# Der Node prüft alle 15 Minuten das signierte Release-Manifest auf GitHub
# (github.com/t0b1as/FND) und empfängt es zusätzlich per P2P. Eine neuere Version
# wird unter Einstellungen → Software-Update ANGEBOTEN und erst auf Klick
# installiert (über den fundus-helper: Signatur- und Hashprüfung, Austausch von
# Programm und Oberfläche mit Rollback; data/, chunks/ und fundus.env bleiben).
#
# Leer = offizielles Manifest (Standard). "off" = Prüfung aus.
#   FUNDUS_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/t0b1as/FND/main/manifest.json
FUNDUS_UPDATE_MANIFEST_URL=
# true = gefundene Updates sofort ohne Rückfrage installieren.
FUNDUS_UPDATE_AUTO=false
# ── Freiwillige Spende (Shop) ────────────────────────────────────────────────
# PayPal-Empfänger für die Spendenkarte im Shop (ohne Gegenleistung).
# Leer = Projekt-Standard, "off" = Karte ausblenden.
FUNDUS_DONATE_PAYPAL=

# ── PoA-Konsens: Validator-Set ──────────────────────────────────────────────
# Komma-getrennte Liste der Node-Adressen, die Bloecke produzieren duerfen
# (Proposer). NUR tatsaechlich laufende Nodes hier eintragen — NICHT den
# Fee-Collector (der ist Signatur-Autoritaet, aber kein Produzent).
#
# WICHTIG: Auf ALLEN Pis muss dieselbe Liste stehen (gleiche Reihenfolge egal,
# wird kanonisch sortiert), damit die Proposer-Rotation uebereinstimmt. Traegt
# ein Pi nur sich selbst ein, laeuft die Rotation auseinander.
#
# Die Node-Adresse eines Pi steht in dessen Wallet/Logs ("PoA-Konsens aktiv …
# proposer=0x…"). Beispiel fuer zwei Pis:
#   FUNDUS_VALIDATORS=0x1bb750693b5dc17ef6534be25c586ab0304abb59,0x0029fd35f5b4ac57c0ce3a29bf08e6f6f236d76d
#
# Leer = Solo-Betrieb: dieser Node ist sein eigener alleiniger Proposer.
FUNDUS_VALIDATORS=

# ============================================================================
# SOLANA / FUNDUS-SHOP  (SOL-Einzahlung → FND-Gutschrift)
# ============================================================================
# Der Shop ueberwacht eine Solana-Empfangsadresse. Zahlt jemand SOL darauf ein,
# schreibt der Node den entsprechenden FND-Betrag gut (Kurs live von CoinGecko/
# Binance/Kraken). Standardmaessig AUS.
#
# --- Aktivierung ---
# Shop einschalten (true/false). Braucht mindestens FUNDUS_SHOP_RECEIVE_ADDR.
FUNDUS_SHOP_ENABLED=false
#
# --- Solana-Anbindung ---
# Solana RPC-Endpunkt. Mainnet (echtes Geld) oder Devnet (Test).
#   Mainnet: https://api.mainnet-beta.solana.com
#   Devnet:  https://api.devnet.solana.com   (fuers Testen ZUERST empfohlen!)
FUNDUS_SHOP_SOLANA_RPC=https://api.devnet.solana.com
#
# Deine Solana-Empfangsadresse (base58). DORTHIN zahlen Kaeufer SOL ein.
# Erzeuge eine Solana-Wallet (z.B. Phantom-Browser-Wallet oder solana-keygen)
# und trage hier die oeffentliche Adresse ein.
FUNDUS_SHOP_RECEIVE_ADDR=
#
# --- Native SOL→FND-Bruecke (empfohlen) ---
# Getrennter Bridge-Schluessel, der SOL→FND-Gutschriften auf der Fundus-Chain
# signiert. NICHT der Node-/FeeCollector-Key! Laeuft nur auf DEINEM Shop-Node,
# wird NIE an Nutzer weitergegeben. Erzeugen mit:  fnd-wallet --gen-hex-key
# Leer = keine native Bruecke (dann Gnosis-ERC20-Fallback, Legacy).
FUNDUS_SHOP_BRIDGE_PRIV_KEY=
#
# Die OEFFENTLICHE Adresse zum Bridge-Schluessel. Muss auf ALLEN Nodes gesetzt
# sein (auch ohne Shop!), damit alle dieselben SOL-Credits als gueltig anerkennen.
# Enthaelt kein Geheimnis. Auf dem Shop-Node muss sie zur Adresse aus
# FUNDUS_SHOP_BRIDGE_PRIV_KEY passen (sonst startet der Node mit Sicherheitsfehler).
FUNDUS_SHOP_BRIDGE_AUTHORITY=
#
# --- Feinabstimmung (optional) ---
# Slippage-Puffer in Basispunkten (50 = 0,5 %). Faengt Kursschwankungen ab.
FUNDUS_SHOP_SLIPPAGE_BPS=50
# Wie lange ein Kursangebot gueltig ist (Sekunden).
FUNDUS_SHOP_OFFER_TTL_SEC=90

# ============================================================================
# ADMIN-ZUGRIFF (Remote-Login über den P2P-Tunnel)
# ============================================================================
# Wallet-Adresse (0x…) des Node-Eigentümers. Wer sich mit dem passenden
# Seed/Passwort anmeldet, erhält Admin-Rechte auch über den Tunnel (Fernzugriff).
# Lokaler Zugriff (direkt am Node) ist immer frei — unabhängig davon.
# Leer = kein Remote-Admin (nur lokaler Zugriff).
#
# Die Adresse aus deinen Seed-Wörtern ermittelst du mit:
#   fnd-wallet --seed-file /pfad/zu/seed.txt --verify
FUNDUS_ADMIN_WALLET=
